# --- Twenty Club ---

# Número de WhatsApp que recibe los pedidos (código de país, sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491123389725

# URL pública del sitio (para SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Panel administrador ---

ADMIN_EMAIL=admin@twentyclub.com
ADMIN_PASSWORD=cambiala
# Secreto que firma la cookie de sesión. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Dónde viven los datos ---
#
#   local     → .data/db.json + /public/uploads
#               Para desarrollo y para un VPS con disco propio.
#               NO funciona en Netlify: el filesystem es de sólo lectura.
#
#   supabase  → Postgres + Storage. Es lo que se usa en producción.
#
DATA_DRIVER=local

# Completá estas dos y poné DATA_DRIVER=supabase.
#
# La clave secreta saltea todas las reglas de seguridad de la base: nunca la
# pongas con prefijo NEXT_PUBLIC_, nunca la subas al repo. El sitio no usa
# Supabase desde el navegador, así que la clave publicable no hace falta.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Si tu proyecto todavía usa las claves viejas, va esta en su lugar:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Hosts extra permitidos para next/image, separados por coma.
# El de Supabase se agrega solo a partir de NEXT_PUBLIC_SUPABASE_URL.
# NEXT_PUBLIC_IMAGE_HOSTS=
